{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "synbrane",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "none"
  },
  "vars": {
    "BACKEND_BASE": "http://147-182-251-148.sslip.io:3001"
  }
}
